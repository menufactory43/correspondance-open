# Surcouche appliquée par-dessus le config.yaml généré par l'image mautrix-instagram
# (`dock.mau.dev/mautrix/meta:ig-*`). Fusion profonde (bootstrap.sh) : on ne fige pas le
# config amont, seulement nos choix.
#
# Depuis v26.08, Instagram a son propre binaire : il n'y a plus de `network.mode`, la
# section `network` ne porte que les réglages du connecteur Instagram.
homeserver:
  address: http://synapse:8008
  domain: correspondance.local
  software: standard

appservice:
  address: http://mautrix-meta:29330
  # 0.0.0.0 dans le conteneur : Synapse appelle le bridge par le réseau Docker.
  hostname: 0.0.0.0
  port: 29330
  id: instagram
  bot:
    # `instagrambot` / `instagram_{{.}}` sont les défauts du bridge, mais l'app les
    # reconnaît par ces chaînes exactes (MatrixBridgeDescriptor) : on les fige ici.
    username: instagrambot
    displayname: Instagram bridge bot
  username_template: instagram_{{.}}

database:
  type: postgres
  uri: postgres://matrix:__POSTGRES_PASSWORD__@postgres/mautrix_meta?sslmode=disable

bridge:
  command_prefix: '!ig'
  # Un espace par compte : l'app filtre déjà, mais ça aide au dépannage dans Element.
  personal_filtering_spaces: true
  private_chat_portal_meta: true
  permissions:
    'correspondance.local': user
    '__MATRIX_ADMIN__': admin

# Mode relais : ce qu'un utilisateur du Relais non connecté au réseau — l'agent
# « cc » — dit dans un portail part via MON compte, préfixé de son nom. Rien ne
# se relaie tout seul : il faut, par room, `!meta set-relay` (admin).
  relay:
    enabled: true
    admin_only: true
    message_formats:
      m.text: '🤖 {{ .Sender.DisambiguatedName }} : {{ .Message }}'
      m.notice: '🤖 {{ .Sender.DisambiguatedName }} : {{ .Message }}'

# Historique initial : sans ça les salons arrivent vides côté Correspondance.
# `thread_backfill.batch_count` vaut 0 par défaut sur Instagram — il faut le demander.
backfill:
  enabled: true
  max_initial_messages: 50
  max_catchup_messages: 500

network:
  thread_backfill:
    batch_count: 1
    batch_delay: 2s

# Double puppeting : sans lui, les messages que j'envoie depuis l'app officielle du
# téléphone remontent signés par mon propre ghost, et Correspondance les prend pour ceux
# d'un correspondant (`isFromMe` = `sender == selfUserID`). Le jeton est celui de
# `doublepuppet-registration.yaml`, côté Synapse.
double_puppet:
  servers: {}
  allow_discovery: false
  secrets:
    # Notre domaine et lui seul : la clé remplace la map d'amont (et son exemple bidon).
    __remplacer__: true
    __SERVER_NAME__: "as_token:__DOUBLEPUPPET_AS_TOKEN__"

# Homeserver privé sur Tailscale, salons de bridge non chiffrés → E2EE inutile.
encryption:
  allow: false
  default: false
  require: false

matrix:
  federate_rooms: false

logging:
  min_level: info
  writers:
    - type: stdout
      format: json
