<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Le LaunchAgent de « cc » sur ce Mac.

  Il vit dans Contents/Library/LaunchAgents/ du bundle : c'est là que
  SMAppService.agent(plistName:) le cherche, et nulle part ailleurs.

  Un plist est statique — il ne connaît ni ~, ni les variables d'environnement
  de la session. D'où `--agent cc` : le binaire en déduit son dossier d'amorce
  (~/.correspondance-agent) et son journal. C'est ce qui permet à un même
  binaire embarqué de servir plusieurs agents.

  BundleProgram : chemin relatif au bundle de l'app. macOS le résout, ce qui
  survit à un déplacement de l'app dans le Finder.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.correspondance.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/correspondance-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/correspondance-agent</string>
		<string>run</string>
		<string>--agent</string>
		<string>cc</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
		<key>Crashed</key>
		<true/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/tmp/correspondance-agent.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/correspondance-agent.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!--
		  Le PATH d'un LaunchAgent est vide : sans ça, ni `claude`, ni l'adaptateur
		  ACP, ni `node` ne seraient trouvables. La recherche des moteurs reste la
		  nôtre (Subprocess.find), ceci n'est qu'un filet.
		-->
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
	</dict>
</dict>
</plist>
