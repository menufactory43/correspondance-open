<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Requis sous Hardened Runtime pour que requestAccess(Contacts) affiche la boîte système. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- Comme Beeper / Franz : Apple Events vers Messages pour envoyer un iMessage. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Le conteneur que l'extension de partage et l'app se partagent (l'index des
	     fils, les dépôts). Forme préfixée par l'équipe : celle qu'un binaire
	     Developer ID porte sans profil, et sans boîte de consentement. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>AKMNXGVVGX.app.correspondance</string>
	</array>
</dict>
</plist>
