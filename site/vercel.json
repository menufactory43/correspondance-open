{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mac",
      "destination": "/api/dl?p=mac"
    },
    {
      "source": "/linux",
      "destination": "/api/dl?p=linux"
    },
    {
      "source": "/ios",
      "destination": "/api/dl?p=ios"
    }
  ]
}
