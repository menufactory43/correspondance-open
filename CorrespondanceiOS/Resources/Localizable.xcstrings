    "Pas disponible sur ce Relais : %@. C'est une fonction propre à Synapse ; ce Relais administre par son salon #admins, qui ne sait pas la faire.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available on this Relay: %@. That's a Synapse-only feature; this Relay is administered through its #admins room, which can't do it."
          }
        },
        "fr": {
