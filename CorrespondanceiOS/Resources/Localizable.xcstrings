          "stringUnit": {
            "state": "translated",
            "value": "cc is already running on %@. Two agents on the same account would answer twice — stop that one first. If you already did, the Relay can take up to fifteen minutes to notice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cc tourne déjà sur %@. Deux agents sur le même compte répondraient deux fois — arrête celui-là d'abord. Si c'est déjà fait, le Relais met jusqu'à un quart d'heure à le voir disparaître."
          }
        }
      }
    },
