    "Le nouveau nom part sur %@ : tout le groupe le verra.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new name goes out on %@: the whole group will see it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau nom part sur %@ : tout le groupe le verra."
          }
        }
      }
    },
    "Le pont n'a pas encore ouvert le fil. Il apparaîtra dans l'inbox dès qu'il l'aura fait.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge hasn’t opened the thread yet. It will appear in your inbox as soon as it does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont n'a pas encore ouvert le fil. Il apparaîtra dans l'inbox dès qu'il l'aura fait."
          }
        }
      }
    },
    "Le pont relit tes conversations…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge is rereading your conversations…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont relit tes conversations…"
          }
        }
      }
    },
    "Le pont traduit les messages entre ce réseau et le Relais : il les lit au passage. Rien de ce qu'on ferait ici n'y changerait quelque chose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge translates messages between this network and the Relay: it reads them along the way. Nothing done here would change that."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont traduit les messages entre ce réseau et le Relais : il les lit au passage. Rien de ce qu'on ferait ici n'y changerait quelque chose."
          }
        }
      }
    },
    "Le prochain message part ici": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next message goes here"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain message part ici"
          }
        }
      }
    },
    "Le retrait part sur le réseau : cette personne ne recevra plus les messages du groupe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The removal goes out on the network: this person will no longer get the group's messages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retrait part sur le réseau : cette personne ne recevra plus les messages du groupe."
          }
        }
      }
    },
    "Le salon est chiffré jusqu'au pont, et le pont le déchiffre pour traduire vers ce réseau : c'est sa fonction. Ce n'est donc pas du bout en bout.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room is encrypted up to the bridge, and the bridge decrypts it to translate for this network: that is its job. So it is not end-to-end."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le salon est chiffré jusqu'au pont, et le pont le déchiffre pour traduire vers ce réseau : c'est sa fonction. Ce n'est donc pas du bout en bout."
          }
        }
      }
    },
    "Le texte se précise depuis un flou": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
