<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Une extension Mac est sandboxée, sans exception. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Le seul chemin vers l'app : le conteneur du groupe, où l'on dépose. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>AKMNXGVVGX.app.correspondance</string>
	</array>
	<!-- Les fichiers que l'autre app nous tend arrivent par le système, pas par un
	     accès disque : aucun droit de lecture n'est demandé. -->
</dict>
</plist>
